# Question generator for Stage-A backtranslation. This model is NEVER trained --
# keeping it separate from the trainee is what avoids a self-generation feedback loop.
ANTHROPIC_API_KEY=
WLM_BACKTRANSLATE_MODEL=claude-sonnet-4-5

# Google Docs read-only ingest. Download an OAuth desktop-app client from
# console.cloud.google.com (enable Drive API + Docs API) and point this at it.
GOOGLE_CLIENT_SECRETS=./client_secret.json
GOOGLE_TOKEN_PATH=./token.json

# Optional
HF_TOKEN=
WANDB_PROJECT=ductus
